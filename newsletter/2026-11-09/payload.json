{
  "nome_campanha": "Radar Estrutural SSM — 2026-11-09",
  "assunto": "Garantia física: debate para usinas solares e eólicas",
  "pre_header": "Consulta do MME, geração compartilhada e Zero Grid para o planejamento de empreendimentos.",
  "html": "<!doctype html>\n<html lang=\"pt-BR\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n    <meta name=\"x-apple-disable-message-reformatting\" />\n    <meta name=\"format-detection\" content=\"telephone=no,address=no,email=no,date=no,url=no\" />\n    <title>Garantia física: debate para usinas solares e eólicas</title>\n  </head>\n  <body style=\"margin:0;padding:0;background-color:#edf2f5;\">\n    <span style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;color:#edf2f5;\">Regras de cálculo, geração compartilhada e Zero Grid para orientar a especificação.</span>\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#EDF2F5\" style=\"background-color:#edf2f5;\">\n      <tr>\n        <td align=\"center\" style=\"padding:0 10px;\">\n          <table role=\"presentation\" width=\"620\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"width:100%;max-width:620px;background-color:#ffffff;\">\n            <tr>\n              <td align=\"right\" bgcolor=\"#041E36\" style=\"padding:9px 30px;background-color:#041e36;color:#b9cedd;font:400 11px Inter,Arial,sans-serif;\">\n                Dificuldade para visualizar? <a href=\"{{ mirror }}\" style=\"color:#ffffff;text-decoration:underline;\">Ver no navegador</a>\n              </td>\n            </tr>\n            <tr>\n              <td height=\"4\" bgcolor=\"#01B5E1\" style=\"height:4px;background-color:#01b5e1;font-size:0;line-height:0;\">&nbsp;</td>\n            </tr>\n            <tr>\n              <td bgcolor=\"#00539C\" style=\"padding:22px 34px;background-color:#00539c;\">\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                  <tr>\n                    <td valign=\"middle\">\n                      <img src=\"https://ssmdobrasil.com.br/wp-content/uploads/2026/10/logotipo-branco-ssm-scaled.png\" width=\"155\" alt=\"SSM do Brasil\" style=\"display:block;width:155px;max-width:100%;height:auto;border:0;\" />\n                    </td>\n                    <td align=\"right\" valign=\"middle\" style=\"color:#ffffff;font:500 12px/1.4 Inter,Arial,sans-serif;\">\n                      Segunda-feira, 9 de novembro de 2026\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <!-- seção: abertura (editorial) — mosaico de 3 capas (uma por destaque do Radar) + título, deck e 3 takeaways -->\n            <tr>\n              <td bgcolor=\"#041E36\" style=\"background-color:#041e36;\">\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                  <tr>\n                    <td width=\"33.33%\" valign=\"top\" style=\"border-right:3px solid #e5f6fb;\"><a href=\"https://canalsolar.com.br/usinas-solares-eolicas-revisao-garantia-fisica/\" style=\"text-decoration:none;\"><img src=\"https://canalsolar.com.br/wp-content/uploads/2026/11/Canal-Solar-Usinas-solares-e-eolicas-entram-em-discussao-sobre-revisao-da-garantia-fisic.webp\" width=\"207\" height=\"210\" alt=\"Usinas solares e eólicas em discussão sobre garantia física\" style=\"display:block;width:100%;height:210px;object-fit:cover;border:0;\" /></a>\n</td>\n                    <td width=\"33.33%\" valign=\"top\" style=\"border-right:3px solid #e5f6fb;\"><a href=\"https://canalsolar.com.br/aneel-mudancas-regras-geracao-compartilhada/\" style=\"text-decoration:none;\"><img src=\"https://canalsolar.com.br/wp-content/uploads/2026/11/Canal-Solar-Area-tecnica-da-ANEEL-propoe-mudancas-nas-regras-de-geracao-compartilhada.webp\" width=\"207\" height=\"210\" alt=\"Proposta de mudanças na geração compartilhada\" style=\"display:block;width:100%;height:210px;object-fit:cover;border:0;\" /></a>\n</td>\n                    <td width=\"33.33%\" valign=\"top\"><a href=\"https://canalsolar.com.br/por-que-zero-grid-atrai-empresas-produtores-rurais/\" style=\"text-decoration:none;\"><img src=\"https://canalsolar.com.br/wp-content/uploads/2026/11/Canal-Solar-Energia-solar-sem-injetar-na-rede-por-que-o-Zero-Grid-atrai-empresas-e-produtores-rurais.webp\" width=\"207\" height=\"210\" alt=\"Energia solar Zero Grid para empresas e produtores rurais\" style=\"display:block;width:100%;height:210px;object-fit:cover;border:0;\" /></a>\n</td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <tr>\n              <td bgcolor=\"#041E36\" style=\"padding:30px 34px 32px;background-color:#041e36;\">\n                <p style=\"margin:0 0 12px;color:#01b5e1;font:600 12px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1.4px;text-transform:uppercase;\">Radar Estrutural SSM</p>\n                <h1 style=\"margin:0 0 12px;color:#ffffff;font:700 34px/1.08 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Garantia física: debate para usinas solares e eólicas</h1>\n                <p style=\"margin:0 0 22px;color:#d7e5ef;font:400 15px/1.6 Inter,Arial,sans-serif;\">Consulta do MME, propostas para a geração compartilhada e aplicações Zero Grid: acompanhe os temas desta edição e seus pontos de atenção para o planejamento de empreendimentos.</p>\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                  <tr>\n                    <td width=\"33%\" valign=\"top\" style=\"padding:0 12px 0 0;color:#ffffff;font:600 12px/1.45 Inter,Arial,sans-serif;\">\n                      <span style=\"color:#01b5e1;font:700 22px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">01</span><br />Garantia física em revisão\n                    </td>\n                    <td width=\"33%\" valign=\"top\" style=\"padding:0 8px;color:#ffffff;font:600 12px/1.45 Inter,Arial,sans-serif;\">\n                      <span style=\"color:#01b5e1;font:700 22px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">02</span><br />Geração compartilhada em debate\n                    </td>\n                    <td width=\"33%\" valign=\"top\" style=\"padding:0 0 0 12px;color:#ffffff;font:600 12px/1.45 Inter,Arial,sans-serif;\">\n                      <span style=\"color:#01b5e1;font:700 22px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">03</span><br />Zero Grid ganha espaço\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <!-- seção: radar-setor (curadoria-externa) — destaque 1 principal; 2 e 3 compactos -->\n            <tr>\n              <td style=\"padding:34px 34px 10px;\">\n                <p style=\"margin:0;color:#00539c;font:600 13px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1.2px;text-transform:uppercase;\">Radar do setor</p>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:14px 34px 24px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border:1px solid #d8e2e8;border-top:4px solid #01b5e1;\">\n  <tr>\n    <td style=\"padding:25px 24px 0;\">\n      <p style=\"margin:0 0 7px;color:#01b5e1;font:600 12px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;\">Regulação</p>\n      <h2 style=\"margin:0 0 10px;color:#0a1a24;font:700 28px/1.12 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Garantia física solar entra em revisão no MME</h2>\n      <p style=\"margin:0 0 17px;color:#34424e;font:400 14px/1.65 Inter,Arial,sans-serif;\">O MME abriu, em 4 de novembro, consulta pública para atualizar metodologias de cálculo e revisão da garantia física de usinas solares e eólicas. A proposta considera particularidades operacionais das fontes e o tratamento dos cortes de geração; as contribuições vão até 18 de dezembro.</p>\n    </td>\n  </tr>\n  <tr>\n    <td bgcolor=\"#E5F6FB\" style=\"padding:15px 24px;background-color:#e5f6fb;color:#0a1a24;font:400 13px/1.55 Inter,Arial,sans-serif;\">\n      <strong>Para a obra:</strong> Revise premissas de geração, conexão e curtailment nos estudos de usinas antes de consolidar a engenharia e os compromissos comerciais.\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:18px 24px 24px;\">\n      <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#00539C\" style=\"padding:10px 17px;background-color:#00539c;\"><a href=\"https://canalsolar.com.br/usinas-solares-eolicas-revisao-garantia-fisica/\" style=\"color:#ffffff;text-decoration:none;font:600 12px Inter,Arial,sans-serif;\">Ler a fonte &#8594;</a></td></tr></table>\n    </td>\n  </tr>\n</table>\n</td>\n            </tr>\n            <tr>\n              <td style=\"padding:0 34px 16px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border:1px solid #d8e2e8;\">\n  <tr>\n    <td style=\"padding:21px 24px;\">\n      <p style=\"margin:0 0 7px;color:#00539c;font:600 12px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;\">Geração distribuída</p>\n      <h2 style=\"margin:0 0 9px;color:#0a1a24;font:700 23px/1.17 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">ANEEL avalia novas condições para geração compartilhada</h2>\n      <p style=\"margin:0 0 13px;color:#34424e;font:400 14px/1.6 Inter,Arial,sans-serif;\">A área técnica da ANEEL recomenda consulta pública sobre permanência mínima dos participantes, divisão de créditos e possíveis cobranças por alterações de beneficiários. A recomendação ainda não altera as regras.</p>\n      <p style=\"margin:0 0 16px;color:#0a1a24;font:600 13px/1.55 Inter,Arial,sans-serif;\">Para a obra: Projetos compartilhados devem manter documentação, titularidade e arranjo de consumidores bem organizados desde a contratação.</p>\n      <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#E5F6FB\" style=\"padding:9px 16px;background-color:#e5f6fb;\"><a href=\"https://canalsolar.com.br/aneel-mudancas-regras-geracao-compartilhada/\" style=\"color:#00539c;text-decoration:none;font:600 12px Inter,Arial,sans-serif;\">Ler a fonte &#8594;</a></td></tr></table>\n    </td>\n  </tr>\n</table>\n</td>\n            </tr>\n            <tr>\n              <td style=\"padding:0 34px 34px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border:1px solid #d8e2e8;\">\n  <tr>\n    <td style=\"padding:21px 24px;\">\n      <p style=\"margin:0 0 7px;color:#00539c;font:600 12px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;\">Aplicações</p>\n      <h2 style=\"margin:0 0 9px;color:#0a1a24;font:700 23px/1.17 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Zero Grid reposiciona projetos com restrição de injeção</h2>\n      <p style=\"margin:0 0 13px;color:#34424e;font:400 14px/1.6 Inter,Arial,sans-serif;\">Empresas e produtores rurais têm recorrido a configurações Zero Grid diante de limites de conexão e exportação. A solução acompanha o consumo e regula a geração fotovoltaica para operar sem injetar excedentes na rede.</p>\n      <p style=\"margin:0 0 16px;color:#0a1a24;font:600 13px/1.55 Inter,Arial,sans-serif;\">Para a obra: A especificação precisa compatibilizar perfil de carga, controle, inversor e estrutura com a estratégia de autoconsumo.</p>\n      <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#E5F6FB\" style=\"padding:9px 16px;background-color:#e5f6fb;\"><a href=\"https://canalsolar.com.br/por-que-zero-grid-atrai-empresas-produtores-rurais/\" style=\"color:#00539c;text-decoration:none;font:600 12px Inter,Arial,sans-serif;\">Ler a fonte &#8594;</a></td></tr></table>\n    </td>\n  </tr>\n</table>\n</td>\n            </tr>\n            <!-- seção: solucao-destaque (rotacao-catalogo) — faixa azul-clara com card branco -->\n            <tr>\n              <td bgcolor=\"#E5F6FB\" style=\"padding:31px 34px;background-color:#e5f6fb;\">\n                <p style=\"margin:0 0 12px;color:#00539c;font:600 12px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;\">Solução em destaque</p>\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"background-color:#ffffff;\">\n  <tr><td><img src=\"https://ssmdobrasil.com.br/wp-content/uploads/2026/07/ACESSORIOS-SSM-1920-x-1080-px-5.png\" width=\"552\" alt=\"Carport solar da SSM do Brasil\" style=\"display:block;width:100%;height:auto;border:0;\" /></td></tr>\n  <tr><td style=\"padding:22px 24px 24px;\"><h2 style=\"margin:0 0 10px;color:#0a1a24;font:700 27px/1.15 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Carport solar: estacionamentos que também geram energia</h2><p style=\"margin:0 0 19px;color:#34424e;font:400 14px/1.6 Inter,Arial,sans-serif;\">Estruturas metálicas para painéis solares em estacionamentos e garagens, configuradas de acordo com vagas, comprimento e número de módulos.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#00539C\" style=\"padding:11px 19px;background-color:#00539c;\"><a href=\"https://ssmdobrasil.com.br/solution/carport/\" style=\"color:#ffffff;text-decoration:none;font:600 13px Inter,Arial,sans-serif;\">Conhecer a solu&ccedil;&atilde;o &#8594;</a></td></tr></table></td></tr>\n</table>\n\n              </td>\n            </tr>\n            <!-- seção: radar-setor / giro rápido (5 curtas) -->\n            <tr>\n              <td style=\"padding:34px 34px 22px;\">\n                <p style=\"margin:0 0 14px;color:#00539c;font:600 13px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1.2px;text-transform:uppercase;\">Giro rápido</p>\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-bottom:1px solid #d8e2e8;\">\n                  <tr><td style=\"padding:12px 0;border-top:1px solid #d8e2e8;\"><a href=\"https://canalsolar.com.br/justica-afasta-icms-creditos-solar-maranhao/\" style=\"color:#0a1a24;text-decoration:none;font:600 14px/1.45 Inter,Arial,sans-serif;\">Justiça afasta ICMS sobre créditos de energia solar no Maranhão <span style=\"color:#01b5e1;\">&#8594;</span></a></td></tr>\n\n                  <tr><td style=\"padding:12px 0;border-top:1px solid #d8e2e8;\"><a href=\"https://canalsolar.com.br/isencao-imposto-importacao-inversores-camara-deputados/\" style=\"color:#0a1a24;text-decoration:none;font:600 14px/1.45 Inter,Arial,sans-serif;\">Isenção de imposto para inversores solares avança na Câmara <span style=\"color:#01b5e1;\">&#8594;</span></a></td></tr>\n\n                  <tr><td style=\"padding:12px 0;border-top:1px solid #d8e2e8;\"><a href=\"https://canalsolar.com.br/parana-chuva-queda-de-energia/\" style=\"color:#0a1a24;text-decoration:none;font:600 14px/1.45 Inter,Arial,sans-serif;\">Tempestades no Paraná ampliam debate sobre solar com armazenamento <span style=\"color:#01b5e1;\">&#8594;</span></a></td></tr>\n\n                  <tr><td style=\"padding:12px 0;border-top:1px solid #d8e2e8;\"><a href=\"https://www.energychannel.co/post/sungrow-entra-em-nova-era-no-mercado-residencial-do-brasil-com-bateria-pr%C3%B3pria-e-inversores-h%C3%ADbridos\" style=\"color:#0a1a24;text-decoration:none;font:600 14px/1.45 Inter,Arial,sans-serif;\">Sungrow apresenta bateria e inversores híbridos para o mercado residencial <span style=\"color:#01b5e1;\">&#8594;</span></a></td></tr>\n\n                  <tr><td style=\"padding:12px 0;border-top:1px solid #d8e2e8;\"><a href=\"https://canalsolar.com.br/mercado-armazenamento-profssionais-qualificados/\" style=\"color:#0a1a24;text-decoration:none;font:600 14px/1.45 Inter,Arial,sans-serif;\">Mercado de armazenamento demanda capacitação técnica <span style=\"color:#01b5e1;\">&#8594;</span></a></td></tr>\n\n                </table>\n              </td>\n            </tr>\n            <!-- seção: blog-ssm (pool-sem-repeticao) -->\n            <tr>\n              <td style=\"padding:8px 34px 36px;\">\n                <p style=\"margin:0 0 12px;color:#00539c;font:600 13px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1.2px;text-transform:uppercase;\">Do blog da SSM</p>\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border:1px solid #d8e2e8;\">\n  <tr><td><img src=\"https://ssmdobrasil.com.br/wp-content/uploads/2026/11/estrutura-carport-solar-ssm.webp\" width=\"550\" alt=\"Estrutura para carport solar\" style=\"display:block;width:100%;height:auto;border:0;\" /></td></tr>\n  <tr><td style=\"padding:22px 24px 24px;\"><p style=\"margin:0 0 7px;color:#01b5e1;font:600 12px 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;letter-spacing:1px;text-transform:uppercase;\">Conte&uacute;do t&eacute;cnico</p><h2 style=\"margin:0 0 10px;color:#0a1a24;font:700 25px/1.16 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Estrutura para carport solar: como escolher a ideal?</h2><p style=\"margin:0 0 18px;color:#34424e;font:400 14px/1.6 Inter,Arial,sans-serif;\">Pilares, vagas, circulação e módulos: o que avaliar ao especificar uma estrutura de carport solar.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#00539C\" style=\"padding:10px 17px;background-color:#00539c;\"><a href=\"https://ssmdobrasil.com.br/2026/11/06/estrutura-carport-solar/\" style=\"color:#ffffff;text-decoration:none;font:600 12px Inter,Arial,sans-serif;\">Ler no blog &#8594;</a></td></tr></table></td></tr>\n</table>\n\n              </td>\n            </tr>\n            <!-- seção: numeros (bloco-fixo) -->\n            <tr>\n              <td bgcolor=\"#00539C\" style=\"padding:0 18px;background-color:#00539c;\">\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr>\n                  <td width=\"33%\" align=\"center\" valign=\"top\" style=\"padding:25px 8px;color:#ffffff;font:700 21px/1.15 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Desde 2010<br /><span style=\"color:#cbe8f4;font:400 11px/1.4 Inter,Arial,sans-serif;\">transformando engenharia em soluções</span></td>\n                  <td width=\"33%\" align=\"center\" valign=\"top\" style=\"padding:25px 8px;color:#ffffff;font:700 21px/1.15 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Até 30 anos<br /><span style=\"color:#cbe8f4;font:400 11px/1.4 Inter,Arial,sans-serif;\">de garantia estrutural</span></td>\n                  <td width=\"33%\" align=\"center\" valign=\"top\" style=\"padding:25px 8px;color:#ffffff;font:700 21px/1.15 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">ISO 9001 e CE<br /><span style=\"color:#cbe8f4;font:400 11px/1.4 Inter,Arial,sans-serif;\">produção certificada</span></td>\n                </tr></table>\n              </td>\n            </tr>\n            <!-- seção: cta-orcamento (bloco-fixo) -->\n            <tr>\n              <td bgcolor=\"#041E36\" align=\"center\" style=\"padding:38px 34px;background-color:#041e36;\">\n                <h2 style=\"margin:0 0 9px;color:#ffffff;font:700 28px/1.15 'Fira Sans Condensed','Arial Narrow',Arial,sans-serif;\">Pronto para o seu próximo projeto?</h2>\n                <p style=\"margin:0 0 21px;color:#d7e5ef;font:400 14px/1.6 Inter,Arial,sans-serif;\">Conte com nossa equipe de engenharia para dimensionar a solução estrutural ideal. Fabricação nacional, qualidade certificada e suporte técnico especializado.</p>\n                <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#01B5E1\" style=\"padding:13px 24px;background-color:#01b5e1;\"><a href=\"https://wa.me/554198418202?text=Ol%C3%A1%2C+vim+da+newsletter+e+gostaria+de+mais+informa%C3%A7%C3%B5es.\" style=\"color:#0a1a24;text-decoration:none;font:700 13px Inter,Arial,sans-serif;\">Solicitar orçamento pelo WhatsApp &#8594;</a></td></tr></table>\n              </td>\n            </tr>\n            <!-- rodapé -->\n            <tr>\n              <td bgcolor=\"#052B4D\" style=\"padding:28px 0 0;background-color:#052b4d;color:#c8d6df;font:400 11px/1.65 Inter,Arial,sans-serif;\">\n                <table role=\"presentation\" width=\"500\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:500px;\"><tr>\n                  <td width=\"38%\" align=\"center\" valign=\"middle\" style=\"padding:8px 18px 22px 20px;\"><img src=\"https://ssmdobrasil.com.br/wp-content/uploads/2026/10/logotipo-branco-ssm-scaled.png\" width=\"145\" alt=\"SSM do Brasil\" style=\"display:block;width:145px;max-width:100%;height:auto;border:0;\" /></td>\n                  <td width=\"62%\" valign=\"top\" style=\"padding:8px 20px 22px 18px;border-left:1px solid #1d4768;\"><strong style=\"color:#ffffff;font:600 11px Inter,Arial,sans-serif;letter-spacing:.7px;text-transform:uppercase;\">SSM do Brasil</strong><br />CNPJ 12.273.815/0001-23<br />Rua Alcídio Zaniolo, 651, Roseira<br />São José dos Pinhais/PR<br /><a href=\"mailto:vendas@ssmdobrasil.com.br\" style=\"color:#01b5e1;text-decoration:none;\">vendas@ssmdobrasil.com.br</a><br /><a href=\"https://wa.me/554198418202\" style=\"color:#01b5e1;text-decoration:none;\">(41) 99841-8202</a></td>\n                </tr></table>\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:15px 30px 25px;border-top:1px solid #1d4768;\"><span style=\"color:#c8d6df;font: